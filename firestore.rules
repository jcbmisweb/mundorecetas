rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminEmail(email) {
      return email in [
        "jcbmisweb@gmail.com",
        "jcbrecetas@gmail.com",
        "jcbprofesor@gmail.com",
        "juan.codina@murciaeduca.es",
        "jcbbinger@gmail.com"
      ];
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && isAdminEmail(request.auth.token.email)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /workspace_invites/{inviteId} {
      allow read, write: if true;
    }

    match /workspace_settings/{workspaceId} {
      allow read, write: if true;
    }

    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    match /proRecipes/{proRecipeId} {
      allow read, write: if true;
    }

    match /pro_recipes/{proRecipeId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /menuPlans/{menuPlanId} {
      allow read, write: if true;
    }

    match /menu_plans/{menuPlanId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
