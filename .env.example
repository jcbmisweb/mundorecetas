# Gemini API (Server-side only - NEVER prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key

# Allowed CORS origins for API endpoints (comma-separated, e.g. https://tudominio.vercel.app)
ALLOWED_ORIGINS=https://your-production-domain.vercel.app
AI_RATE_LIMIT_PER_MIN=20
STANDALONE_STRICT_FRAME=false

# Supabase Configuration (Optional secondary storage - public anon key only, protected by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
